---
import { siteSummary } from "../content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
}

const {
  title = "Indulge — Enjoy on purpose",
  description = "Keep the pleasure. Trade the time you lose. Indulge is a private iPhone app for making room for more of the life you want.",
  canonicalPath = "/",
  image = "/images/brand/indulge-social.jpg"
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image, Astro.site);
const configuredBetaUrl = import.meta.env.PUBLIC_TESTFLIGHT_URL?.trim();
const hasVerifiedBetaUrl = configuredBetaUrl?.startsWith("https://testflight.apple.com/");
const betaHref = hasVerifiedBetaUrl ? configuredBetaUrl : "/testflight/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E1F0FC" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Indulge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="robots" content="index,follow" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          name: "Significant Hobbies",
          url: "https://significanthobbies.com",
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "customer support",
            email: "support@significanthobbies.com",
            url: "https://indulge.significanthobbies.com/support/"
          },
          address: {
            "@type": "PostalAddress",
            addressCountry: "US"
          }
        },
        {
          "@type": "SoftwareApplication",
          name: "Indulge",
          operatingSystem: "iOS",
          applicationCategory: "LifestyleApplication",
          description,
          url: String(canonical),
          screenshot: siteSummary.screenshots.map((path) => new URL(path, Astro.site).href),
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
        },
        {
          "@type": "FAQPage",
          mainEntity: siteSummary.faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: { "@type": "Answer", text: faq.answer }
          }))
        }
      ]
    })} />
    <title>{title}</title>
    <script is:inline>
      !function(t,e){var o,n,a,r;function s(e){(o=t._phq=t._phq||[]).push([].slice.call(e))}o=t.posthog=function(e,n){s([e,n])},o.__loaded||(a=e.createElement("script"),a.type="text/javascript",a.async=!0,a.crossOrigin="anonymous",a.src="https://us.i.posthog.com/array.js",r=e.getElementsByTagName("script")[0],r.parentNode.insertBefore(a,r),o.__loaded=!0),t.posthog.init("phc_qgiAarw4Co4pw9fz3Fxj4UJaHmqzFetqs4JrXhGc35Nd",{api_host:"https://us.i.posthog.com",person_profiles:"always",capture_pageview:!1,autocapture:!1,loaded:function(){t.posthog.capture("page_view",{project_id:"indulge"})}})}(window,document);
    </script>
    <!-- Microsoft Clarity — session replay + heatmaps (additive; PostHog stays) -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/y6bwf6hr76";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","y6bwf6hr76");
      window.clarity("set","project_id","indulge");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label="Indulge home">
          <img src="/images/brand/indulge-mark-128.jpg" width="38" height="38" alt="" />
          <span>Indulge</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/#how-it-works">How it works</a>
          <a href="/#privacy">Privacy</a>
          <a class="header-beta" href={betaHref}>{hasVerifiedBetaUrl ? "Join the beta ↗" : "Beta status"}</a>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div>
          <a class="wordmark" href="/">
            <img src="/images/brand/indulge-mark-128.jpg" width="38" height="38" alt="" loading="lazy" decoding="async" />
            <span>Indulge</span>
          </a>
          <p class="fine-print" style="margin-top: 14px">A reflective wellbeing tool, not medical care, addiction treatment, or Screen Time enforcement. © 2026 Sarthak Agrawal.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/privacy/">Privacy</a>
          <a href="/support/">Support</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility/">Accessibility</a>
          <a href="/testflight/">TestFlight</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
